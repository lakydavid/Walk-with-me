# Copy this file to .env and fill in real values. .env is gitignored.

# Supabase project credentials. The anon key is safe to ship in the binary
# because all access is gated by Row Level Security, but we keep it out of
# git so a leaked dev value can't bleed into a prod build.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Android Google Maps SDK key. Must be restricted in the GCP console to:
#   - Application: Android apps
#   - Package name: com.lakydavid.walkwithme
#   - SHA-1 fingerprint of the signing certificate
# (otherwise anyone can pull it out of the APK and use it.)
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=AIza...

# URL hosting the public privacy policy. Required by Play Store.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://lakydavid.github.io/Walk-with-me/privacy
